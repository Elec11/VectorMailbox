{
  "gmail_user": "you@gmail.com",
  "gmail_app_password": "xxxx xxxx xxxx xxxx",
  "imap_host": "imap.gmail.com",
  "imap_port": 993,
  "imap_timeout": 90,
  "smtp_host": "smtp.gmail.com",
  "smtp_port": 465,
  "gmail_account_index": 0,

  "embed_endpoint": "https://your-embed-host/v1/embeddings",
  "embed_api_key": "sk-...",
  "embed_model": "",
  "embed_timeout": 120,
  "dim": 768,

  "db_path": "mailbox.db",
  "folders": ["INBOX"],
  "batch_size": 32,
  "fetch_batch_size": 10,

  "prune_deleted": true,
  "prune_max_fraction": 0.25,
  "prune_restore": true,
  "reconcile_batch_size": 500,
  "restore_probe_max": 2000,

  "profile": "v2",
  "prompt_scheme": "gemma",
  "query_task": "search result",
  "doc_title_from_subject": true,
  "query_prompt": "SearchQuery",
  "doc_prompt": "Document",

  "thread_context_depth": 2,
  "thread_context_chars": 200,
  "max_attachment_mb": 10,
  "embed_audio": false,
  "pdf_pages_as_images": false,
  "embed_media_multimodal": true,
  "media_item_shape": "image_url",
  "decode_mime_words": true,

  "store_thumbs": true,
  "thumb_max_side": 320,
  "media_cache_mb": 512,
  "media_db_path": "",

  "render_html": true,
  "render_html_max_bytes": 2000000,
  "show_remote_images": false,

  "clean_text": true,
  "keep_quoted_in_fts": true,
  "index_dedupe_threads": true,

  "chunk_sizes": { "small": 320, "large": 1200, "xlarge": 6000 },
  "chunk_overlap_frac": 0.15,
  "max_source_chars": 6000,
  "max_windows_per_source": 24,
  "index_tiers": ["small", "large", "xlarge"],
  "tier_weights": {},

  "fts_tokenizer": "unicode61 remove_diacritics 2",
  "fts_meta_weight": 1.5,
  "fts_quoted_weight": 0.6,
  "fts_full_match_bonus": 1.25,
  "fts_stopwords": true,
  "fts_or_first": true,
  "expand_morphology": true,
  "stopwords_file": "",
  "synonyms_file": "",

  "search_mode": "hybrid",
  "rrf_k": 20,
  "agg_k": 3,
  "lexical_pool": 200,
  "dense_pool": 0,
  "fusion_pool": 200,
  "w_dense": 0.5,
  "w_lex": 0.5,
  "tier_norm": true,
  "window_dedupe": 0.92,
  "collapse": true,
  "collapse_sim": 0.97,
  "min_relevance": 0.3,
  "snippet": true,
  "parse_filters": true,

  "recency_half_life_days": 240,
  "recency_weight": 0.35,
  "demote_transactional": 0.55,
  "transactional_senders": [],

  "rerank": "off",
  "rerank_endpoint": "",
  "rerank_model": "",
  "rerank_api_key": "",
  "rerank_timeout": 120,
  "rerank_candidates": 40,
  "rerank_blend": 0.7
}
